#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "$0")/buildenv-vars"

# assets/ci is the single source of truth for the packaged map manifest,
# native Sauerbraten map menus, downloaded map assets, and release metadata.
# Keep every categorized rotation available inside the build container.
ASSET_FFA_MAPS=${ASSET_FFA_MAPS:-$ASSET_MAPS}
ASSET_CAPTURE_MAPS=${ASSET_CAPTURE_MAPS:-}
ASSET_CTF_MAPS=${ASSET_CTF_MAPS:-}

$CONTAINER_CMD run \
  --rm \
  --user "$HOST_UID:$HOST_GID" \
  --env-file "$PROJECT_ROOT/docker/common.env" \
  -e ASSET_OUTPUT_DIR=dist \
  -e ASSET_CACHE_DIR="$ASSET_CACHE_DIR" \
  -e ASSET_MAPS="$ASSET_MAPS" \
  -e ASSET_FFA_MAPS="$ASSET_FFA_MAPS" \
  -e ASSET_CAPTURE_MAPS="$ASSET_CAPTURE_MAPS" \
  -e ASSET_CTF_MAPS="$ASSET_CTF_MAPS" \
  -v "$PROJECT_ROOT":/workspace \
  -w /workspace/assets \
  "$IMAGE_TAG" \
  bash -lc '
    set -euo pipefail
    mkdir -p "$HOME" "$PIP_CACHE_DIR" "$ASSET_CACHE_DIR"
    python3 -m pip install --user -r requirements.txt || true
    ./ci
  '

echo "Successfully built and verified assets"
