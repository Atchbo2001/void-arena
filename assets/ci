#!/usr/bin/env bash

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

cd "$SCRIPT_DIR"

set -euo pipefail

if ! pip3 list | grep "cbor2" > /dev/null 2>&1; then
  pip3 install -r requirements.txt
fi

mkdir -p cache

./setup

outdir=${ASSET_OUTPUT_DIR:-output}
asset_maps=${ASSET_MAPS:-"complex dust2 turbine"}
read -r -a packaged_maps <<< "$asset_maps"

if [ "${#packaged_maps[@]}" -eq 0 ]; then
  echo "ASSET_MAPS did not contain any maps" >&2
  exit 1
fi

# Sauerbraten's stock menus include hundreds of maps even when this hosted build
# only packages a small vetted set. Generate both autoexec.cfg and a direct
# menus.cfg catalog patch from the same exact ASSET_MAPS list so every native
# in-game map picker and custom-game creator only offers maps that exist here.
PACKAGED_MAPS="$asset_maps" python3 - <<'PY'
import os
import re
from pathlib import Path

maps = []
for value in os.environ["PACKAGED_MAPS"].split():
    value = value.strip()
    if value and value not in maps:
        maps.append(value)

if not maps:
    raise SystemExit("packaged map manifest is empty")

catalog = " ".join(maps)
lines = [
    "// Generated by assets/ci from ASSET_MAPS. Do not edit manually.",
    f'packagedmaps = "{catalog}"',
    'ffamaps1 = $packagedmaps',
]

for index in range(2, 12):
    lines.append(f'ffamaps{index} = ""')
for index in range(1, 8):
    lines.append(f'capturemaps{index} = ""')
for index in range(1, 8):
    lines.append(f'ctfmaps{index} = ""')

lines.extend([
    'conceptmaps = ""',
    'spmaps = ""',
    'rpgmaps = ""',
    'allffamaps = $packagedmaps',
    'allcapturemaps = ""',
    'allctfmaps = ""',
    'allmaps = $packagedmaps',
    '',
])

catalog_text = "\n".join(lines)
Path("sour/autoexec.cfg").write_text(catalog_text)

menus_path = Path("sour/data/menus.cfg")
menus = menus_path.read_text()
menus = re.sub(
    r'//17\n\nffamaps1 = .*?\nallmaps = \(concat \$allffamaps \$allcapturemaps \$allctfmaps \$conceptmaps \$spmaps \$rpgmaps\)',
    '//17\n\n' + catalog_text.rstrip(),
    menus,
    count=1,
    flags=re.S,
)
menus = re.sub(
    r'showcustommaps = \[\n    custommaps = ""\n    loopfiles curmap "packages/base" "ogz" \[\n        if \(< \(indexof \$allmaps \$curmap\) 0\) \[\n            custommaps = \(concat \$custommaps \(escape \$curmap\)\)\n        \]\n    \]\n    custommaps = \(sortlist \$custommaps x y \[naturalsort \$x \$y\]\)\n    showgui custommaps\n\]',
    'showcustommaps = [\n    custommaps = $packagedmaps\n    showgui custommaps\n]',
    menus,
    count=1,
)
menus_path.write_text(menus)
print(f"native packaged map catalog ({len(maps)}): {catalog}")
PY

python3 base.py \
        --root https://static.sourga.me/blobs/6481/.index.source \
        --models \
        --download \
        --outdir dist \
        "${packaged_maps[@]}"

# base.py downloads the browser asset copy of data/menus.cfg into dist under a
# content-addressed name. Patch that generated text asset too; the web client
# loads this copy, not sour/data/menus.cfg, so this is the part that controls the
# in-browser custom game map selector.
PACKAGED_MAPS="$asset_maps" python3 - <<'PY'
import os
import re
from pathlib import Path

maps = []
for value in os.environ["PACKAGED_MAPS"].split():
    value = value.strip()
    if value and value not in maps:
        maps.append(value)
if not maps:
    raise SystemExit("packaged map manifest is empty")

catalog = " ".join(maps)
lines = [
    "// Generated by assets/ci from ASSET_MAPS. Do not edit manually.",
    f'packagedmaps = "{catalog}"',
    'ffamaps1 = $packagedmaps',
]
for index in range(2, 12):
    lines.append(f'ffamaps{index} = ""')
for index in range(1, 8):
    lines.append(f'capturemaps{index} = ""')
for index in range(1, 8):
    lines.append(f'ctfmaps{index} = ""')
lines.extend([
    'conceptmaps = ""',
    'spmaps = ""',
    'rpgmaps = ""',
    'allffamaps = $packagedmaps',
    'allcapturemaps = ""',
    'allctfmaps = ""',
    'allmaps = $packagedmaps',
])
replacement = '//17\n\n' + "\n".join(lines)
custom_replacement = 'showcustommaps = [\n    custommaps = $packagedmaps\n    showgui custommaps\n]'

patched = []
for path in Path("dist").iterdir():
    if not path.is_file() or path.name.startswith("."):
        continue
    try:
        text = path.read_text()
    except UnicodeDecodeError:
        continue
    if 'ffamaps1 = "aard3c' not in text or 'showcustommaps' not in text:
        continue
    original = text
    text = re.sub(
        r'//17\n\nffamaps1 = .*?\nallmaps = \(concat \$allffamaps \$allcapturemaps \$allctfmaps \$conceptmaps \$spmaps \$rpgmaps\)',
        replacement,
        text,
        count=1,
        flags=re.S,
    )
    text = re.sub(
        r'showcustommaps = \[\n    custommaps = ""\n    loopfiles curmap "packages/base" "ogz" \[\n        if \(< \(indexof \$allmaps \$curmap\) 0\) \[\n            custommaps = \(concat \$custommaps \(escape \$curmap\)\)\n        \]\n    \]\n    custommaps = \(sortlist \$custommaps x y \[naturalsort \$x \$y\]\)\n    showgui custommaps\n\]',
        custom_replacement,
        text,
        count=1,
    )
    if text == original:
        raise SystemExit(f"found stock menus asset but failed to patch {path}")
    path.write_text(text)
    patched.append(path.name)

if not patched:
    raise SystemExit("did not find generated stock menus.cfg asset in dist")
print(f"patched generated menus asset(s): {', '.join(patched)}")
PY
