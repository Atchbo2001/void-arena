#!/usr/bin/env bash

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

cd "$SCRIPT_DIR"

set -euo pipefail

if ! pip3 list | grep "cbor2" > /dev/null 2>&1; then
  pip3 install -r requirements.txt
fi

mkdir -p cache

./setup

outdir=${ASSET_OUTPUT_DIR:-dist}
asset_maps=${ASSET_MAPS:-"complex turbine dust2"}
ffa_maps=${ASSET_FFA_MAPS:-"$asset_maps"}
capture_maps=${ASSET_CAPTURE_MAPS:-""}
ctf_maps=${ASSET_CTF_MAPS:-""}

# Validate the curated manifest against the stock Sauerbraten catalog before
# downloading anything. This prevents typos or invented map names from silently
# entering a release. Mode-specific lists must also be subsets of ASSET_MAPS.
PACKAGED_MAPS="$asset_maps" \
FFA_MAPS="$ffa_maps" \
CAPTURE_MAPS="$capture_maps" \
CTF_MAPS="$ctf_maps" \
python3 - <<'PY'
import os
import re
from pathlib import Path


def unique_words(name: str) -> list[str]:
    values: list[str] = []
    for value in os.environ.get(name, "").split():
        value = value.strip()
        if value and value not in values:
            values.append(value)
    return values


packaged = unique_words("PACKAGED_MAPS")
ffa = unique_words("FFA_MAPS")
capture = unique_words("CAPTURE_MAPS")
ctf = unique_words("CTF_MAPS")

if not packaged:
    raise SystemExit("ASSET_MAPS did not contain any maps")

for label, values in (("FFA", ffa), ("Capture", capture), ("CTF", ctf)):
    missing = sorted(set(values) - set(packaged))
    if missing:
        raise SystemExit(f"{label} map list contains maps not in ASSET_MAPS: {', '.join(missing)}")

menus = Path("sour/data/menus.cfg").read_text()
stock: set[str] = set()
for prefix in ("ffamaps", "capturemaps", "ctfmaps"):
    for match in re.finditer(rf'^{prefix}\d*\s*=\s*"([^"]*)"', menus, re.MULTILINE):
        stock.update(match.group(1).split())

unknown = sorted(set(packaged) - stock)
if unknown:
    raise SystemExit(
        "ASSET_MAPS contains names that are not in the stock Sauerbraten multiplayer catalog: "
        + ", ".join(unknown)
    )

catalog = " ".join(packaged)
lines = [
    "// Generated by assets/ci from the validated packaged-map manifest.",
    "// Do not edit manually.",
    f'packagedmaps = "{catalog}"',
    f'ffamaps1 = "{" ".join(ffa)}"',
]

for index in range(2, 12):
    lines.append(f'ffamaps{index} = ""')

lines.append(f'capturemaps1 = "{" ".join(capture)}"')
for index in range(2, 8):
    lines.append(f'capturemaps{index} = ""')

lines.append(f'ctfmaps1 = "{" ".join(ctf)}"')
for index in range(2, 8):
    lines.append(f'ctfmaps{index} = ""')

lines.extend([
    'conceptmaps = ""',
    'spmaps = ""',
    'rpgmaps = ""',
    'allffamaps = $ffamaps1',
    'allcapturemaps = $capturemaps1',
    'allctfmaps = $ctfmaps1',
    'allmaps = $packagedmaps',
    '',
])

Path("sour/autoexec.cfg").write_text("\n".join(lines))
print(f"validated packaged maps ({len(packaged)}): {catalog}")
print(f"FFA ({len(ffa)}): {' '.join(ffa)}")
print(f"Capture ({len(capture)}): {' '.join(capture)}")
print(f"CTF ({len(ctf)}): {' '.join(ctf)}")
PY

read -r -a packaged_maps <<< "$asset_maps"

# A clean output directory makes every release reproducible and prevents stale
# map bundles from an older build from surviving after the manifest changes.
rm -rf "$outdir"
mkdir -p "$outdir"

python3 base.py \
        --root https://static.sourga.me/blobs/6481/.index.source \
        --models \
        --download \
        --outdir "$outdir" \
        "${packaged_maps[@]}"

PACKAGED_MAPS="$asset_maps" \
FFA_MAPS="$ffa_maps" \
CAPTURE_MAPS="$capture_maps" \
CTF_MAPS="$ctf_maps" \
MAP_OUTPUT_DIR="$outdir" \
python3 - <<'PY'
import json
import os
from pathlib import Path


def words(name: str) -> list[str]:
    return [value for value in os.environ.get(name, "").split() if value]

manifest = {
    "maps": words("PACKAGED_MAPS"),
    "ffa": words("FFA_MAPS"),
    "capture": words("CAPTURE_MAPS"),
    "ctf": words("CTF_MAPS"),
}
path = Path(os.environ["MAP_OUTPUT_DIR"]) / "packaged-maps.json"
path.write_text(json.dumps(manifest, indent=2) + "\n")
print(f"wrote {path}")
PY
